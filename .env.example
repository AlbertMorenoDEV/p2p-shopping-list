# Optional: WebSocket sync server URL.
# Defaults to the public Yjs demo relay (wss://demos.yjs.dev/ws).
# Point this to your own Cloudflare Worker (see README.md) for durable async sync.
# VITE_WS_URL=wss://shopping-sync.<your-subdomain>.workers.dev/parties/shopping-room

# Optional: Room namespace prefix used on shared WebSocket relays.
# VITE_WS_ROOM_PREFIX=albertmoreno-shopping-v2
